{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "georgestephanis/timesheets",
    "description": "Single-file CLI tool that aggregates ActivityWatch, Chrome history, and git commits into a project-based activity report.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "erusev/parsedown-extra": "^0.9.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:json": "npm run format:check",
        "lint:fix": "phpcbf",
        "analyze": "phpstan analyse --memory-limit 512M",
        "check": [
            "@lint",
            "@lint:json",
            "@analyze"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
