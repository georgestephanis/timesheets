<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for Hermes (React Native JS engine) and Node.js JIT compilation -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Required for loading the better-sqlite3 native module in the engine sidecar -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Required for Harvest, ClickUp, Clockify, GitHub, and LLM API calls -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
