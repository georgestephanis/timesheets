{
    "name": "timesheets",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:js": "eslint apps/web/static/app.js",
        "lint:js:fix": "eslint --fix apps/web/static/app.js",
        "desktop:start": "npm run start -w @timesheets/desktop",
        "desktop:macos": "npm run macos -w @timesheets/desktop",
        "desktop:dev": "bash tools/desktop-dev.sh",
        "desktop:dev:clean": "bash tools/desktop-dev.sh --clean",
        "test": "npm run test -w @timesheets/engine -w @timesheets/test-fixtures",
        "typecheck": "npm run typecheck -w @timesheets/engine",
        "check": "composer check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "prettier": "^3.0"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
