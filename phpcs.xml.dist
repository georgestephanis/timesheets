<?xml version="1.0"?>
<ruleset name="timesheets">
    <description>Coding standards for activity-report.php (PSR-12 with CLI-script exceptions).</description>

    <file>activity-report.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <!-- CLI scripts intentionally mix declarations and top-level side effects. -->
        <exclude name="PSR1.Files.SideEffects"/>
        <!--
            The shebang line (#!/usr/bin/env php) confuses the PSR-12 header-order
            check. Exclude the whole sniff; the docblock position is correct.
        -->
        <exclude name="PSR12.Files.FileHeader"/>
    </rule>

    <!-- Raise line-length warning threshold; a single-file tool has some long signatures. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
