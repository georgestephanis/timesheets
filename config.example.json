{
    "$schema": "./config.schema.json",

    "timezone": "America/New_York",

    "paths": {
        "activitywatch": "~/Library/Application Support/activitywatch",
        "chrome": "~/Library/Application Support/Google/Chrome",
        "chrome_profiles": null
    },

    "git_authors": ["you@example.com"],

    "discover_repos": "github_desktop",

    "chrome_correlation_window_seconds": 120,
    "min_event_seconds_to_show": 30,

    "projects": {
        "Acme Corp": {
            "grouping": "Acme",
            "repos": ["~/code/acme-backend", "~/code/acme-frontend"],
            "repo_remotes": {
                "~/code/acme-backend": {
                    "origin": "git@github.com:example/acme-backend.git"
                },
                "~/code/acme-frontend": {
                    "origin": "git@github.com:example/acme-frontend.git",
                    "upstream": "git@github.com:upstream/acme-frontend.git"
                }
            },
            "vscode_dirs": ["acme-backend", "acme-frontend", "acme"],
            "domains": ["acme.com", "*.acme.com", "acme.local", "acme.wp.local"],
            "harvest_projects": ["Acme*"],
            "clickup_tasks": ["*acme*"],
            "slack": [{ "workspace": "Acme Corp" }],
            "ssh_hosts": ["acme-prod", "acme-staging*"]
        },

        "Acme Docs": {
            "grouping": "Acme",
            "repos": ["~/code/acme-docs"],
            "vscode_dirs": ["acme-docs"],
            "domains": ["docs.acme.com"]
        },

        "Personal Projects": {
            "repos": ["~/code/my-side-project"],
            "vscode_dirs": ["my-side-project"],
            "domains": ["my-side-project.com", "*.my-side-project.com"],
            "apps": ["my-side-project*app"]
        }
    },

    "personal_hosts": [
        "x.com",
        "twitter.com",
        "*.twitter.com",
        "*.facebook.com",
        "facebook.com",
        "discord.com",
        "*.discord.com",
        "*.reddit.com",
        "reddit.com",
        "*.youtube.com",
        "youtube.com",
        "*.instagram.com",
        "instagram.com"
    ],

    "personal_apps": ["Discord", "Messenger"],

    "ignored_projects": [],

    "groupings_map": {
        "connections": {
            "*client-a*": "Client A",
            "*client-b*": "Client B"
        },
        "clickup_default": "Client A",
        "priority": ["Client A", "Client B"]
    },

    "integrations": {
        "harvest": [
            {
                "name": "Harvest Main",
                "account_id": "123456",
                "token": "HARVEST_PERSONAL_ACCESS_TOKEN",
                "user_id": "1234567"
            }
        ],
        "clickup": [
            {
                "name": "ClickUp Main",
                "team_id": ["1234567", "7654321"],
                "token": "CLICKUP_PERSONAL_ACCESS_TOKEN",
                "assignee": "me"
            }
        ],
        "github": [
            {
                "name": "GitHub via gh",
                "usernames": ["your-github-login"],
                "authors": ["you@example.com"]
            }
        ],
        "llm": [
            {
                "name": "Local Ollama",
                "base_url": "http://localhost:11434/v1",
                "api_key": "ollama",
                "model": "llama3"
            }
        ]
    }
}
