{
    "$schema": "./config.schema.json",

    "timezone": "America/New_York",

    "paths": {
        "activitywatch": "~/Library/Application Support/activitywatch",
        "chrome": "~/Library/Application Support/Google/Chrome",
        "chrome_profiles": null
    },

    "git_authors": ["you@example.com"],

    "chrome_correlation_window_seconds": 120,
    "min_event_seconds_to_show": 30,

    "projects": {
        "Acme Corp": {
            "grouping": "Acme",
            "repos": ["~/code/acme-backend", "~/code/acme-frontend"],
            "vscode_dirs": ["acme-backend", "acme-frontend", "acme"],
            "domains": ["acme.com", "*.acme.com", "acme.local", "acme.wp.local"],
            "slack": [{ "workspace": "Acme Corp" }],
            "ssh_hosts": ["acme-prod", "acme-staging*"]
        },

        "Acme Docs": {
            "grouping": "Acme",
            "repos": ["~/code/acme-docs"],
            "vscode_dirs": ["acme-docs"],
            "domains": ["docs.acme.com"]
        },

        "Personal Projects": {
            "repos": ["~/code/my-side-project"],
            "vscode_dirs": ["my-side-project"],
            "domains": ["my-side-project.com", "*.my-side-project.com"],
            "apps": ["my-side-project*app"]
        }
    },

    "personal_hosts": [
        "x.com",
        "twitter.com",
        "*.twitter.com",
        "*.facebook.com",
        "facebook.com",
        "discord.com",
        "*.discord.com",
        "*.reddit.com",
        "reddit.com",
        "*.youtube.com",
        "youtube.com",
        "*.instagram.com",
        "instagram.com"
    ],

    "personal_apps": ["Discord", "Messenger"],

    "ignored_projects": []
}
